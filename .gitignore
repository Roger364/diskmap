# Artefacts de compilation
/target

# Caches de scan (régénérés à la demande, volumineux)
*.bin

# Binaires : celui construit en CI est téléchargé ici, il ne se versionne pas
*.exe
*.pdb

# Journal du filet de sécurité des sondes (local, jamais versionné)
tests/sondes/filet-suppressions.log

# Dépendances des sondes navigateur (installées par `npm ci`, cf. package-lock)
tests/sondes/node_modules/

# Données locales du projet (mémoire de travail, épreuves en cours). Non
# versionnées — et IGNORÉES, pas seulement non suivies : un dossier non suivi
# mais non ignoré apparaît dans `git status --porcelain`, donc tout contrôle
# d'arbre propre le prend pour du travail en cours. `epreuve.mjs` refuse de
# démarrer sur un arbre sale : sans cette ligne, il refusait à cause de ce
# dossier, et son refus accusait un travail qui n'existait pas.
.workbuddy-ai/
